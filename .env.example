# ---------------------------------------------------------------------------
# Required — the app will not boot without these
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_mgt?schema=public

FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:4000

# Minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=

# ---------------------------------------------------------------------------
# Optional, defaults shown
# ---------------------------------------------------------------------------
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
# 15m is the production value. Raise it locally (12h) if re-authorizing Swagger
# gets in the way; never on an instance holding real data.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Google sign-in. /auth/google returns an error until these are set.
# ---------------------------------------------------------------------------
# CLIENT_ID=
# CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Who may create an account.
#
# Default `true`: anyone can register themselves, which mints verification
# codes and reset links — so in production that shape REQUIRES the mail
# settings below, and the app refuses to boot without them.
#
# Set `false` and `register`, `resend-otp` and `forgot-password` all refuse.
# Nothing mints a secret, so no mail provider is needed at all. Accounts are
# then created with the CLI:
#
#   npm run build
#   node dist/cli/admin create-org --org "Adebayo Stores" \
#     --first Ade --last Bayo --email owner@example.com
#   node dist/cli/admin set-password --email owner@example.com
#
# This is how the hosted instance runs. Leave it alone locally: smoke registers
# an organization and needs it on.
# ---------------------------------------------------------------------------
# SELF_SERVE_SIGNUP=true

# ---------------------------------------------------------------------------
# Transactional email (Resend). Unset in development, MailService logs the
# OTP and reset link to the console instead of sending them.
#
# Required in production only while SELF_SERVE_SIGNUP is true — see above.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# MAIL_FROM=noreply@example.com
# CONTACT_EMAIL=support@example.com

# Accepts this value as a valid OTP. Development only — never set in production.
# OTP_OVERRIDE=

# ---------------------------------------------------------------------------
# Slice 2 — product images (Cloudinary)
# ---------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
