# ---------------------------------------------------------------------------
# Required — the app will not boot without these
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_mgt?schema=public

FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:4000

# Minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=

# ---------------------------------------------------------------------------
# Optional, defaults shown
# ---------------------------------------------------------------------------
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Google sign-in. /auth/google returns an error until these are set.
# ---------------------------------------------------------------------------
# CLIENT_ID=
# CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Transactional email (Resend). Unset in development, MailService logs the
# OTP and reset link to the console instead of sending them.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# MAIL_FROM=noreply@example.com
# CONTACT_EMAIL=support@example.com

# Accepts this value as a valid OTP. Development only — never set in production.
# OTP_OVERRIDE=

# ---------------------------------------------------------------------------
# Slice 2 — product images (Cloudinary)
# ---------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
